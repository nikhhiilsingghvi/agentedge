# ──────────────────────────────────────────────────────────────────────────────
# AgentEdge .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl
*.pyd

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ── API Keys & Secrets — NEVER commit ─────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
secrets.py
credentials.json
token.json
*.pem
*.p12

# ── AgentEdge runtime output (generated — do not commit) ─────────────────────
logs/
*.log
*.jsonl
benchmark_results/

# ── Model weight files (too large for git) ────────────────────────────────────
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.tflite
models/
weights/

# ── Test & Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.coveragerc
report.xml

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
.pytype/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE & Editors ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.ropeproject/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── AI tool configuration (IDE-specific, not project code) ────────────────────
# Antigravity / Gemini IDE agent scaffolding
.agents/
.claude/
.planning/
skills-lock.json

# ── Documents & Presentations (binary, not code) ─────────────────────────────
*.pptx
*.ppt
*.docx
*.doc
*.xlsx
*.xls
*.pdf
ppt_extract.txt

# ── Temporary / scratch ───────────────────────────────────────────────────────
scratch/
*.tmp
*.bak
*.orig
result analysis tables/

# ── Docs site (generated, not source) ────────────────────────────────────────
docs/
_site/
site/